{
  "name": "@usequeek/create-theme",
  "version": "0.3.1",
  "description": "npm create @usequeek/theme — start a Queek storefront theme from the official starter.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "create-theme": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "giget": "^3.3.1"
  },
  "keywords": [
    "queek",
    "theme",
    "storefront",
    "create",
    "starter"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usequeek/theme-tools.git",
    "directory": "packages/create-theme"
  },
  "bugs": "https://github.com/usequeek/theme-tools/issues",
  "homepage": "https://github.com/usequeek/theme-tools/tree/main/packages/create-theme#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
