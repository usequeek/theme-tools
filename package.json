{
  "name": "@usequeek/theme-tools-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "publint": "pnpm -r exec publint --strict",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "node scripts/check-starter-tag.mjs && pnpm build && changeset publish",
    "e2e": "node scripts/e2e.mjs"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^9.0.0",
    "@queekai/client-sdk": "^0.3.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@usequeek/theme-kit": "^0.1.10",
    "eslint": "^10.10.0",
    "globals": "^17.0.0",
    "next": "^16.0.0",
    "publint": "^0.3.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "semver": "^7.8.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.0.0"
  }
}
